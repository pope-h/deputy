# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_PRIVATE_KEY=
AGENT_NAME=Deputy
AGENT_SOURCE_URL=

# ── Chain ─────────────────────────────────────────────────────────────────────
NETWORK=mainnet
CELO_RPC_URL=https://forno.celo.org
CELO_RPC_FALLBACK_URLS=https://celo.drpc.org

# Pay gas in a stablecoin instead of CELO, so the wallet needs only one asset.
# USDm on mainnet: 0x765DE816845861e75A25fCA122bb6898B8B1282a
FEE_CURRENCY_ADDRESS=

# Refuse to start work below this native balance (wei). Prevents stranding a
# half-finished action the agent cannot pay to complete.
MIN_GAS_WEI=500000000000000000

# Program attribution tag, if the agent is entered in one.
ATTRIBUTION_TAG=

# ── Reasoning (optional) ──────────────────────────────────────────────────────
# Unset and every capability uses its local fallback. The same happens on its
# own if credit runs out or the key is revoked.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=low
LLM_TIMEOUT_MS=8000
LLM_MAX_CONSECUTIVE_FAILURES=3

# ── Capability: zplague ───────────────────────────────────────────────────────
# Unset ZPLAGUE_CONTRACT to disable.
ZPLAGUE_CONTRACT=0xe157fD2564246Afa41cfAFaDA01a9A6f3e082710
ZPLAGUE_API=https://api.zplague.xyz
ZPLAGUE_MAX_STAKE_WEI=10000000000000000

# ── Capability: x402 ──────────────────────────────────────────────────────────
# Unset X402_RESOURCE_URL to disable.
X402_RESOURCE_URL=
X402_MAX_PRICE=10000
X402_MIN_INTERVAL_MS=300000
