# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_PRIVATE_KEY=
AGENT_NAME=Deputy
AGENT_SOURCE_URL=

# ── Chain ─────────────────────────────────────────────────────────────────────
NETWORK=mainnet
CELO_RPC_URL=https://forno.celo.org
CELO_RPC_FALLBACK_URLS=https://celo.drpc.org

# Pay gas in a stablecoin instead of CELO, so the wallet needs only one asset.
# USDm on mainnet: 0x765DE816845861e75A25fCA122bb6898B8B1282a
FEE_CURRENCY_ADDRESS=

# Refuse to start work below this native balance (wei). Prevents stranding a
# half-finished action the agent cannot pay to complete.
MIN_GAS_WEI=500000000000000000

# Program attribution tag, if the agent is entered in one.
ATTRIBUTION_TAG=

# ── Reasoning (optional) ──────────────────────────────────────────────────────
# Unset and every capability uses its local fallback. The same happens on its
# own if credit runs out or the key is revoked.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=low
LLM_TIMEOUT_MS=8000
LLM_MAX_CONSECUTIVE_FAILURES=3

# ── Capability: zplague ───────────────────────────────────────────────────────
# Unset ZPLAGUE_CONTRACT to disable.
ZPLAGUE_CONTRACT=0xe157fD2564246Afa41cfAFaDA01a9A6f3e082710
ZPLAGUE_API=https://api.zplague.xyz
# USDm (cUSD) — the only asset the game stakes.
ZPLAGUE_STAKE_TOKEN=0x765DE816845861e75A25fCA122bb6898B8B1282a
# Highest stake the agent will sit down for (wei, 18 dec). 0.01 USDm.
ZPLAGUE_MAX_STAKE_WEI=10000000000000000

# Open a room when none is available, instead of waiting to be invited.
# OFF by default: hosting stakes real money without being asked to, and an
# agent that spends on its first run is a bad default however autonomous it is.
ZPLAGUE_HOST_WHEN_EMPTY=false
ZPLAGUE_HOST_STAKE_WEI=10000000000000000
# Contract allows 4..20 seats; the game starts at 3 players.
ZPLAGUE_HOST_MAX_PLAYERS=4

# Brakes. Games sat down for per rolling 24h, and total USDm drawdown before
# the agent stops taking new seats. A game already paid for always finishes.
ZPLAGUE_MAX_GAMES_PER_DAY=4
ZPLAGUE_DAILY_LOSS_CAP_WEI=50000000000000000

# Role commitment cache. Proving costs 30-120s of the game's shared CPU and the
# commitment is not bound to a room, so it is generated once and reused.
ZPLAGUE_PROOF_CACHE=./data/role-proof.json

# How long to let the model think before voting randomly instead. The voting
# phase is 120s, and a timeout bills for the tokens AND votes at random, so
# being stingy here is the one setting that costs money to get wrong.
ZPLAGUE_VOTE_TIMEOUT_MS=25000

# ── Capability: askbots ──────────────────────────────────────────────────────
# Reviews other builders' projects for $0.10 USDT on Celo. The key is read from
# ~/.config/askbots/credentials.json when this is unset — do not commit it, and
# never send it to any host but www.askbots.ai.
ASKBOTS_API_KEY=
ASKBOTS_API=https://www.askbots.ai/api
# Stay under the account's own cap, which scales with age and rating.
# A review pays $0.10 and costs ~23k in / 4k out tokens. Opus 5 would cost
# ~$0.22 to earn $0.10. Haiku 4.5 costs ~$0.04 and clears the same bar.
ASKBOTS_MODEL=claude-haiku-4-5-20251001
ASKBOTS_MAX_PER_DAY=10
ASKBOTS_MIN_INTERVAL_MS=600000
# Review projects whose paid budget is spent. They pay nothing but still earn
# the usefulness rating that raises the daily cap. Set false to skip them.
ASKBOTS_INCLUDE_UNPAID=true

# ── Capability: x402 ──────────────────────────────────────────────────────────
# Unset X402_RESOURCE_URL to disable.
X402_RESOURCE_URL=
X402_MAX_PRICE=10000
X402_MIN_INTERVAL_MS=300000
